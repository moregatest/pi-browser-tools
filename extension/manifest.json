{
  "manifest_version": 3,
  "name": "secret-broker 登入",
  "version": "0.3.2",
  "description": "secret-broker 代登入的填值端與補登記錄端：只接受本機原生主程式（com.tung.secret_broker）的指令，在指定分頁填帳密；補登期間在指定分頁記下 owner 的一次登入。",
  "key": "",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "nativeMessaging",
    "scripting",
    "storage",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "secret-broker 登入"
  }
}
